# Configure through the hosting platform's encrypted environment variables.
# Never commit a real key.
OPENAI_API_KEY=your_server_side_key
OPENAI_MODEL=gpt-4.1-mini

# Configurable cost assumptions used only to estimate each evaluation run.
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_OUTPUT_USD_PER_MILLION=1.60
